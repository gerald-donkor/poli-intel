// EviBrief — Policy Intelligence & Brief Generator (Tropenbos Ghana)
//
// Model names are Prisma-conventional PascalCase and @@map to the spec's
// snake_case table names, so spec §4.1's entity names stay the database's
// source of truth.
//
// Vector columns are declared as Unsupported("vector(N)") — Prisma has no
// native vector scalar. N MUST equal EMBEDDING_DIMENSIONS in lib/ai/config.ts.
// SQL DDL cannot import TypeScript, so this literal is the one unavoidable
// second copy of that number; the data layer validates vector length against
// the constant before writing.
//
// NEVER RUN `prisma migrate dev` ON THIS SCHEMA.
// Prisma has no HNSW index type, so the pgvector similarity indexes exist only
// in migration SQL and are invisible here. Every diff therefore proposes
// dropping them, and `migrate dev` writes that DROP into the migration it
// generates — leaving both vector columns unindexed and every retrieval a
// sequential scan. Author migrations with `npm run db:migrate:new`, which
// filters those drops out, and apply them with `npm run db:migrate`.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (Migrate/Studio) and in
// the driver adapter in lib/db/client.ts (Prisma Client). Not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — declared once here and imported everywhere (AGENTS.md §12.7).
// Values are spec-verbatim. Never re-declared as string unions in UI code.
// ---------------------------------------------------------------------------

/// Declaration order IS the design system's warm→cool ramp
/// (immediate bronze → near-term olive → horizon teal → watch slate).
/// Never resort this enum.
enum Urgency {
  immediate
  near_term
  horizon
  watch

  @@map("urgency")
}

enum Relevance {
  core
  adjacent
  background

  @@map("relevance")
}

enum ImpactArea {
  restoration
  community_forestry
  diversified_production
  cross_cutting

  @@map("impact_area")
}

enum Geography {
  ghana_national
  cocoa_belt_landscapes
  international
  multi_level

  @@map("geography")
}

/// Signal-level audience targeting (spec §3.2). NOT the five brief-generation
/// audience profiles (spec §3.4) — collapsing those two lists needs a recorded
/// decision and there isn't one.
enum AudienceTarget {
  ministry
  cocobod
  eu_institutions
  private_sector
  community_governance

  @@map("audience_target")
}

/// The five BRIEF-GENERATION audience profiles, spec §3.4's tailoring table
/// verbatim. Separate from AudienceTarget above by decision, not by oversight:
/// the two lists genuinely differ. Spec §3.4 carries "Donor / programme officer",
/// which has no signal-level equivalent, and its "Cocoa company (sustainability
/// team)" is a company, not Cocobod the regulator. Mapping one list onto the
/// other would silently lose an audience the generator is required to serve
/// (AGENTS.md §16.3), so `brief.audience` uses this enum and a policy signal's
/// own targeting keeps AudienceTarget.
///
/// Framing emphasis and tone per profile live in lib/ai/audience-profiles.ts —
/// one config location, keyed by these values.
enum BriefAudience {
  ghana_ministry_official
  cocoa_company_sustainability
  eu_regulator
  donor_programme_officer
  crema_community_governance

  @@map("brief_audience")
}

/// Where a generation attempt got to. An attempt is NOT a brief: nothing is
/// reachable at /briefs/[id] until the fact-check pass has run and `complete` is
/// reached (AGENTS.md §9.1).
enum GenerationStage {
  retrieving
  drafting
  verifying
  complete
  failed
  /// A run that produced a verified draft the officer chose NOT to take up —
  /// the audience switcher's discard. Distinct from `failed`, which means the
  /// run did not produce one: a discarded reframe is a record that two Gemini
  /// requests were spent and a person decided against the result (§8).
  discarded

  @@map("generation_stage")
}

/// Why an attempt ended at `failed`. A rate limit is deliberately absent: a 429
/// preserves the attempt and its draft so the officer can retry, so it is a
/// returned state rather than a terminal one (AGENTS.md §13.4).
enum GenerationFailureReason {
  invalid_output
  request_failed
  missing_api_key

  @@map("generation_failure_reason")
}

enum BriefType {
  policy_brief
  technical_submission
  position_paper
  stakeholder_note
  media_backgrounder

  @@map("brief_type")
}

enum BriefStatus {
  draft
  reviewed
  submitted
  published

  @@map("brief_status")
}

enum SignalStatus {
  new
  reviewed
  actioned
  archived

  @@map("signal_status")
}

enum EvidenceSourceType {
  field_data
  research
  literature

  @@map("evidence_source_type")
}

/// The governance gate's vocabulary (AGENTS.md §7.4). Exactly these three.
/// Only `public_published` is eligible for the AI pipeline.
enum Classification {
  public_published
  community_sourced
  unpublished_internal

  @@map("classification")
}

enum StaffRole {
  programme_director
  policy_advocacy_officer
  research_officer
  field_officer

  @@map("staff_role")
}

enum FlagReason {
  unsupported
  altered
  misattributed

  @@map("flag_reason")
}

enum FlagStatus {
  open
  resolved
  dismissed

  @@map("flag_status")
}

enum IngestionOutcome {
  succeeded
  failed

  @@map("ingestion_outcome")
}

/// How one Policy Radar attempt against one source ended.
///
/// `empty` and `failed` are separate values because the weekly gap analysis
/// cannot otherwise tell a broken scraper from a quiet week — silence is
/// reported, not assumed (AGENTS.md §14.7). `not_implemented` is the third
/// kind of silence: a source declared in the registry whose retrieval method
/// has no implementation yet, which must read as "not yet monitored" rather
/// than as a source that found nothing.
enum RadarOutcome {
  found
  empty
  failed
  not_implemented

  @@map("radar_outcome")
}

/// What one Evidence Matcher attempt produced.
///
/// `gap` is a RESULT, not a failure: nothing cleared the threshold, and that is
/// a stored fact rather than an absence somebody has to notice
/// (AGENTS.md §15, `evidence-matcher` rule 4). `failed` means the attempt could
/// not be completed — the signal had no vector, or the rerank could not be
/// obtained.
enum EvidenceMatchOutcome {
  matched
  gap
  failed

  @@map("evidence_match_outcome")
}

// ---------------------------------------------------------------------------
// Actors
// ---------------------------------------------------------------------------

/// Auth.js v5 runs a JWT session strategy, so there are no adapter tables here.
/// StaffUser exists because the schema independently needs a durable actor to
/// reference from every audit row (AGENTS.md §8.3, §8.6, §10.8) — role
/// assignment must survive a session, so it is a row, not a JWT claim.
model StaffUser {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  briefGenerations        BriefGeneration[]
  briefsCreated           Brief[]                     @relation("BriefCreatedBy")
  briefsReviewed          Brief[]                     @relation("BriefReviewedBy")
  briefVersionsCreated    BriefVersion[]
  evidenceIngested        EvidenceItem[]
  flagsResolved           HallucinationFlag[]
  briefStatusChanges      BriefStatusChange[]
  signalReclassifications SignalReclassification[]
  classificationChanges   EvidenceClassificationChange[]
  stakeholderSharesLogged StakeholderBrief[]

  @@map("staff_user")
}

// ---------------------------------------------------------------------------
// Policy Radar
// ---------------------------------------------------------------------------

model PolicySignal {
  id         String   @id @default(uuid())
  sourceUrl  String   @map("source_url")
  sourceName String   @map("source_name")
  detectedAt DateTime @map("detected_at")

  /// The detected document's own headline, stored verbatim from the source.
  ///
  /// Not in spec §4.1's field list, and added deliberately: domain-level
  /// deduplication is fuzzy matching over titles BEFORE the insert
  /// (AGENTS.md §14.4), so a stored, comparable title is what makes "the same
  /// notice at two URLs is one signal" possible at all. `summaryText` cannot
  /// serve — it is produced by the classification call, which runs after the
  /// dedup decision has already been taken.
  title String

  urgency     Urgency
  relevance   Relevance
  impactArea  ImpactArea   @map("impact_area")
  geography   Geography

  /// Signal-level audience targeting (spec §3.2), set by the classification
  /// call alongside the four enums above.
  ///
  /// NULLABLE, unlike its four siblings, and for a reason that only applies to
  /// it: the other four were non-nullable from the initial migration, whereas
  /// this column is being added to a table that may already hold rows. A
  /// default would stamp every pre-radar signal with an audience nobody chose,
  /// which is the same defect as inventing a default urgency — a fabricated
  /// classification in front of a reviewer. Absent is honest; wrong is not.
  audienceTarget AudienceTarget? @map("audience_target")

  summaryText String       @map("summary_text")
  status      SignalStatus @default(new)

  /// vector(1536) — see EMBEDDING_DIMENSIONS in lib/ai/config.ts.
  embedding      Unsupported("vector(1536)")?
  /// Which embedding model produced `embedding`. Changing models invalidates
  /// existing vectors; without this there is no safe re-embedding path.
  embeddingModel String?                      @map("embedding_model")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  briefs            Brief[]
  briefGenerations  BriefGeneration[]
  reclassifications SignalReclassification[]
  evidenceMatches   SignalEvidenceMatch[]
  matchRuns         EvidenceMatchRun[]

  @@index([status])
  @@index([urgency])
  @@index([detectedAt])
  @@map("policy_signal")
}

/// One Policy Radar attempt against one source — the record that makes
/// "silence is reported, not assumed" possible (AGENTS.md §14.7).
///
/// EVERY attempt writes exactly one row, including the ones that found nothing
/// and the ones that failed. Without this table the weekly gap analysis cannot
/// distinguish a scraper broken by a site redesign from a genuinely quiet week,
/// and a source that has silently stopped working looks exactly like a source
/// with no news.
///
/// Ids, counts, outcomes and short machine reasons ONLY — the same rule as
/// IngestionLog. Never a scraped body, never a fetched document's text, never a
/// caught error's message (§7.6, §13.9).
model RadarRun {
  id         String   @id @default(uuid())
  /// The registry key from lib/radar/sources.ts, stable across renames.
  sourceId   String   @map("source_id")
  sourceName String   @map("source_name")

  outcome              RadarOutcome
  itemsSeen            Int          @default(0) @map("items_seen")
  signalsCreated       Int          @default(0) @map("signals_created")
  duplicatesSuppressed Int          @default(0) @map("duplicates_suppressed")
  /// Short machine reason, never a fetched document or an error message.
  failureReason        String?      @map("failure_reason")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  /// The one query the gap analysis runs: recent runs, by source. Nothing
  /// speculative alongside it (AGENTS.md §12.5).
  @@index([sourceId, startedAt])
  @@map("radar_run")
}

/// One Evidence Matcher attempt against one signal — RadarRun's counterpart for
/// retrieval, and for the same reason.
///
/// EVERY attempt writes exactly one row, including the ones that matched
/// nothing and the ones that failed. That is what makes the gap DATA: the
/// weekly gap analysis and the signal board read `outcome` rather than
/// inferring "no evidence" from an empty join, which cannot tell "we looked and
/// found nothing" apart from "we never looked" (`evidence-matcher` rule 4).
///
/// Ids, counts, outcomes and short machine reasons ONLY — the same rule as
/// RadarRun and IngestionLog. Never a signal summary, never a candidate
/// excerpt, never a caught error's message (§7.6, §13.9).
model EvidenceMatchRun {
  id       String @id @default(uuid())
  signalId String @map("signal_id")

  outcome EvidenceMatchOutcome

  /// Items that cleared MATCHER_MIN_SIMILARITY and entered the rerank.
  candidateCount Int @default(0) @map("candidate_count")
  /// Items stored as matches. At most MATCHER_MATCH_SET_SIZE.
  matchedCount   Int @default(0) @map("matched_count")
  /// Candidates dropped because the item was reclassified between the query and
  /// the rerank call. A COUNT ONLY — never the ids' titles or text (§7.6).
  refusedCount   Int @default(0) @map("refused_count")

  /// Short machine reason, never an excerpt or an error message.
  failureReason String? @map("failure_reason")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  signal PolicySignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  /// The one query the gap analysis and the signal board run: recent runs for a
  /// signal. Nothing speculative alongside it (AGENTS.md §12.5).
  @@index([signalId, startedAt])
  @@map("evidence_match_run")
}

/// A signal's CURRENT match set — one row per matched evidence item.
///
/// Run rows accumulate; these do not. A re-match replaces the whole set in one
/// transaction, so the board never renders half of it.
///
/// This is NOT the evidence set a brief was generated from. That is
/// `BriefEvidence`, written from the officer's final selection after add and
/// remove, and it is what the fact-check pass verifies against
/// (`evidence-matcher` rule 5).
model SignalEvidenceMatch {
  signalId       String @map("signal_id")
  evidenceItemId String @map("evidence_item_id")

  /// Cosine similarity of the item's closest chunk, `1 - distance`.
  similarity   Float
  /// The rerank's 0–1 score. NULL where the model omitted this candidate from
  /// its response — kept at its retrieval rank rather than silently deleted.
  rerankScore  Float? @map("rerank_score")
  /// Position in the stored set, 1-based, after the rerank.
  rank         Int
  /// Which chunk matched, so the passage can be quoted without re-running
  /// retrieval.
  chunkOrdinal Int    @map("chunk_ordinal")

  matchedAt DateTime @default(now()) @map("matched_at")

  signal       PolicySignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Restrict)

  @@id([signalId, evidenceItemId])
  @@index([evidenceItemId])
  @@map("signal_evidence_match")
}

// ---------------------------------------------------------------------------
// Evidence library
// ---------------------------------------------------------------------------

model EvidenceItem {
  id          String             @id @default(uuid())
  title       String
  authors     String[]
  year        Int?
  sourceType  EvidenceSourceType @map("source_type")
  country     String?
  impactArea  ImpactArea?        @map("impact_area")
  fullText    String             @map("full_text")
  citationKey String             @unique @map("citation_key")

  /// THE GATE, schema half (AGENTS.md §7.3, §12.2). Required, never nullable,
  /// and defaulted to the safe state so a row arriving by ANY path — upload,
  /// field submission, scrape, bulk import, raw insert — is already blocked
  /// from the AI pipeline until a Research Officer tags it.
  classification Classification @default(unpublished_internal)

  // Ingestion provenance
  sourceUrl            String?   @map("source_url")
  sourceFileName       String?   @map("source_file_name")
  ingestedById         String?   @map("ingested_by_id")
  ingestedAt           DateTime  @default(now()) @map("ingested_at")
  extractionCompletedAt DateTime? @map("extraction_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ingestedBy            StaffUser?                     @relation(fields: [ingestedById], references: [id], onDelete: SetNull)
  chunks                EvidenceChunk[]
  briefEvidence         BriefEvidence[]
  ingestionLogs         IngestionLog[]
  classificationChanges EvidenceClassificationChange[]
  signalMatches         SignalEvidenceMatch[]

  @@index([classification])
  @@index([impactArea])
  @@index([sourceType])
  @@index([country, year])
  @@index([ingestedById])
  @@map("evidence_item")
}

/// 512-token overlapping segments (spec §4.2). Chunk-level metadata lives here;
/// document-level metadata lives on EvidenceItem.
///
/// Classification is deliberately NOT duplicated here — retrieval joins to the
/// parent, so a chunk can never disagree with its item (AGENTS.md §7, §12.4).
model EvidenceChunk {
  id             String @id @default(uuid())
  evidenceItemId String @map("evidence_item_id")
  ordinal        Int
  chunkText      String @map("chunk_text")
  charStart      Int    @map("char_start")
  charEnd        Int    @map("char_end")
  sourcePage     Int?   @map("source_page")

  /// vector(1536) — see EMBEDDING_DIMENSIONS in lib/ai/config.ts.
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")

  createdAt DateTime @default(now()) @map("created_at")

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)

  @@unique([evidenceItemId, ordinal])
  @@map("evidence_chunk")
}

// ---------------------------------------------------------------------------
// Briefs
// ---------------------------------------------------------------------------

model Brief {
  id       String  @id @default(uuid())
  /// Nullable: the Phase 1 manual generator has staff paste a policy document
  /// with no signal record behind it.
  signalId String? @map("signal_id")

  briefType BriefType     @map("brief_type")
  audience  BriefAudience
  status    BriefStatus   @default(draft)
  /// Pointer to the current BriefVersion.version. 0 = no version persisted yet.
  currentVersion Int       @default(0) @map("current_version")

  generatedAt  DateTime? @map("generated_at")
  createdById  String?   @map("created_by_id")
  reviewedById String?   @map("reviewed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signal     PolicySignal? @relation(fields: [signalId], references: [id], onDelete: SetNull)
  createdBy  StaffUser?    @relation("BriefCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy StaffUser?    @relation("BriefReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  versions         BriefVersion[]
  /// A LIST, not one. The first generation produced this brief; every audience
  /// switch after it is another real attempt against the same brief.
  generations      BriefGeneration[]
  /// The FINAL evidence set after officer add/remove — the set the fact-check
  /// pass verifies against, not raw matcher output (AGENTS.md §15.5).
  evidenceSet      BriefEvidence[]
  influenceEvents  InfluenceEvent[]
  statusChanges    BriefStatusChange[]
  stakeholderShares StakeholderBrief[]

  @@index([status])
  @@index([signalId])
  @@index([createdById])
  @@index([reviewedById])
  @@map("brief")
}

model BriefEvidence {
  briefId        String   @map("brief_id")
  evidenceItemId String   @map("evidence_item_id")
  relevanceScore Float?   @map("relevance_score")
  addedAt        DateTime @default(now()) @map("added_at")

  brief        Brief        @relation(fields: [briefId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Restrict)

  @@id([briefId, evidenceItemId])
  @@index([evidenceItemId])
  @@map("brief_evidence")
}

/// Every edit is versioned and no prior version is ever overwritten in place
/// (AGENTS.md §8.7). Flags hang off a version, not off the brief.
model BriefVersion {
  id      String @id @default(uuid())
  briefId String @map("brief_id")
  version Int

  /// The reader THIS version was written for.
  ///
  /// `Brief.audience` is the CURRENT audience — what the header and the brief
  /// list read. Once an audience switch can produce version N+1 for a different
  /// reader, that single column can no longer say who version 3 was written for,
  /// and `brief-output` rule 5 requires a brief to record its audience alongside
  /// its version. Backfilled from `Brief.audience` in the migration, so no
  /// version is ever ambiguous.
  audience        BriefAudience

  bodyText        String  @map("body_text")
  /// Tiptap document JSON for this version.
  documentJson    Json?   @map("document_json")
  generatingModel String? @map("generating_model")
  promptVersion   String? @map("prompt_version")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  brief     Brief      @relation(fields: [briefId], references: [id], onDelete: Cascade)
  createdBy StaffUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  flags HallucinationFlag[]

  @@unique([briefId, version])
  @@index([createdById])
  @@map("brief_version")
}

/// One run of the three-stage generator, and the reason a failed generation is a
/// real, queryable outcome rather than a lost request (AGENTS.md §9.4).
///
/// AN ATTEMPT IS NOT A BRIEF. The row exists from the moment the officer presses
/// Generate, but nothing is loadable at /briefs/[id] and nothing appears in the
/// brief list until the fact-check pass has run and `briefId` is set in the same
/// transaction that creates the Brief — which is what preserves §9.1's ordering.
///
/// `policyText` is the pasted external policy document. It is NOT evidence: it
/// never becomes an evidence_item, is never embedded, and lives nowhere else.
model BriefGeneration {
  id          String        @id @default(uuid())
  createdById String        @map("created_by_id")
  briefType   BriefType     @map("brief_type")
  audience    BriefAudience

  /// The signal this attempt was opened from, carried through to `Brief.signalId`
  /// by the stage-3 transaction.
  ///
  /// ON THE ATTEMPT, not re-derived at stage 3. The three stages are three
  /// separate requests minutes apart, so reading the association back off a query
  /// parameter would mean trusting the browser for a stored relation.
  ///
  /// Nullable because the manual generator is not going away: staff paste a
  /// policy document with no signal record behind it, exactly as `Brief.signalId`
  /// already allows.
  signalId String? @map("signal_id")

  /// The pasted policy document, capped by BRIEF_POLICY_TEXT_MAX_CHARS.
  policyText String @map("policy_text")
  /// The evidence set the officer chose, gated at stage 1 and re-gated nowhere
  /// else. Ids only — never evidence body text (AGENTS.md §7.6).
  evidenceItemIds String[] @map("evidence_item_ids")

  stage         GenerationStage          @default(retrieving)
  failureReason GenerationFailureReason? @map("failure_reason")

  /// The Zod-validated draft from stage 2, held here so a stage-3 rate limit
  /// cannot lose it. Never unvalidated model output (AGENTS.md §9.4).
  draftJson       Json?   @map("draft_json")
  generatingModel String? @map("generating_model")
  promptVersion   String? @map("prompt_version")

  /// The stage-3 fact-check verdicts, held here for the same reason `draftJson`
  /// is: an audience switch shows the officer a diff and waits for a human
  /// decision before anything is written (§8.3), so the pass has returned but
  /// its flags have nowhere to live yet. Storing them means the flags the
  /// officer reviewed are the flags that land — re-running the pass at commit
  /// would spend another free-tier request AND could produce a different set,
  /// which would make the review a record of something else.
  ///
  /// Zod-validated on the way back out, exactly like `draftJson`. A first
  /// generation persists in the same request and leaves this null.
  factCheckJson   Json?   @map("fact_check_json")

  /// The brief this attempt belongs to.
  ///
  /// TWO WAYS IT IS SET, and they are different facts:
  ///   - a FIRST generation has no brief until the stage-3 transaction creates
  ///     one, so this is written there, at the end;
  ///   - an AUDIENCE SWITCH names the brief being reframed and is written at
  ///     creation, because the attempt reads its policy text and evidence set
  ///     from that brief's own records.
  ///
  /// So this is no longer the record that the fact-check pass ran — `stage` is
  /// (`complete` is reachable only after the pass returned). Not unique: a brief
  /// reframed twice has three attempts, and each is a real record of a real
  /// generation.
  briefId String? @map("brief_id")

  startedAt DateTime @default(now()) @map("started_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy StaffUser     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  brief     Brief?        @relation(fields: [briefId], references: [id], onDelete: SetNull)
  signal    PolicySignal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([createdById, startedAt])
  @@index([signalId])
  @@index([briefId])
  @@map("brief_generation")
}

/// Hallucination-guard flag: a structured record anchored to a document
/// position, stored against a BriefVersion so regeneration or audience
/// switching never inherits cleared state.
///
/// ANCHOR REPRESENTATION (decided here, per prompt 04): a Tiptap document
/// position range `{from, to}` stored as anchorFrom/anchorTo, plus claimText
/// for re-anchoring when ordinary editing around the claim shifts positions.
/// This is what the flag Mark in `tiptap-editor` maps to.
model HallucinationFlag {
  id             String @id @default(uuid())
  briefVersionId String @map("brief_version_id")

  anchorFrom Int    @map("anchor_from")
  anchorTo   Int    @map("anchor_to")
  /// The claim exactly as generated — also the re-anchoring key.
  claimText  String @map("claim_text")

  reason FlagReason
  /// Ids of the evidence items this claim was checked against. Ids only —
  /// never evidence body text (AGENTS.md §7.6).
  checkedEvidenceItemIds String[] @map("checked_evidence_item_ids")

  status           FlagStatus @default(open)
  resolvedById     String?    @map("resolved_by_id")
  resolvedAt       DateTime?  @map("resolved_at")
  resolutionReason String?    @map("resolution_reason")

  createdAt DateTime @default(now()) @map("created_at")

  briefVersion BriefVersion @relation(fields: [briefVersionId], references: [id], onDelete: Cascade)
  resolvedBy   StaffUser?   @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([briefVersionId, status])
  @@index([resolvedById])
  @@map("hallucination_flag")
}

// ---------------------------------------------------------------------------
// Impact
// ---------------------------------------------------------------------------

model InfluenceEvent {
  id             String   @id @default(uuid())
  briefId        String   @map("brief_id")
  eventType      String   @map("event_type")
  sourceDocument String?  @map("source_document")
  detectedAt     DateTime @map("detected_at")
  description    String
  verified       Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  brief Brief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@map("influence_event")
}

// ---------------------------------------------------------------------------
// Stakeholder CRM
// ---------------------------------------------------------------------------

model Stakeholder {
  id                String          @id @default(uuid())
  name              String
  organisation      String?
  role              String?
  audienceType      AudienceTarget? @map("audience_type")
  preferredLanguage String?         @map("preferred_language")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Join table, so brief history is queryable rather than a scalar array.
  briefHistory StakeholderBrief[]

  @@map("stakeholder")
}

model StakeholderBrief {
  stakeholderId String   @map("stakeholder_id")
  briefId       String   @map("brief_id")
  sharedAt      DateTime @default(now()) @map("shared_at")
  note          String?

  /// WHO logged the share, taken from the session and never from the client.
  ///
  /// "This brief reached the Ministry" is a materially weaker record than "Ama
  /// sent this brief to the Ministry on 4 August", and the Impact Tracker traces
  /// an influence event back through exactly this row. Nullable because the
  /// column was added after the table existed and rows written before it have no
  /// honest answer — inventing one would be worse than a null. `SetNull` on
  /// delete for the same reason: a departed colleague does not erase the share.
  sharedById String?    @map("shared_by_id")
  sharedBy   StaffUser? @relation(fields: [sharedById], references: [id], onDelete: SetNull)

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  brief       Brief       @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@id([stakeholderId, briefId])
  @@index([briefId])
  @@map("stakeholder_brief")
}

// ---------------------------------------------------------------------------
// Audit rows — actor + timestamp, never a mutable column
// (AGENTS.md §8.3, §8.6, §10.8)
// ---------------------------------------------------------------------------

model BriefStatusChange {
  id             String       @id @default(uuid())
  briefId        String       @map("brief_id")
  actorId        String       @map("actor_id")
  previousStatus BriefStatus? @map("previous_status")
  newStatus      BriefStatus  @map("new_status")
  reason         String?
  changedAt      DateTime     @default(now()) @map("changed_at")

  brief Brief     @relation(fields: [briefId], references: [id], onDelete: Cascade)
  actor StaffUser @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([briefId])
  @@index([actorId])
  @@map("brief_status_change")
}

model SignalReclassification {
  id                String    @id @default(uuid())
  signalId          String    @map("signal_id")
  actorId           String    @map("actor_id")
  previousUrgency   Urgency   @map("previous_urgency")
  newUrgency        Urgency   @map("new_urgency")
  previousRelevance Relevance @map("previous_relevance")
  newRelevance      Relevance @map("new_relevance")
  reason            String?
  changedAt         DateTime  @default(now()) @map("changed_at")

  signal PolicySignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  actor  StaffUser    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([signalId])
  @@index([actorId])
  @@map("signal_reclassification")
}

/// Classification changes are restricted to Research Officer and Programme
/// Director and are logged with actor and timestamp (AGENTS.md §10.8).
model EvidenceClassificationChange {
  id                     String         @id @default(uuid())
  evidenceItemId         String         @map("evidence_item_id")
  actorId                String         @map("actor_id")
  previousClassification Classification @map("previous_classification")
  newClassification      Classification @map("new_classification")
  reason                 String?
  changedAt              DateTime       @default(now()) @map("changed_at")

  evidenceItem EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)
  actor        StaffUser    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([evidenceItemId])
  @@index([actorId])
  @@map("evidence_classification_change")
}

// ---------------------------------------------------------------------------
// Ingestion log (AGENTS.md §12.8) — ids, counts and outcomes only.
// Never document or evidence body text.
// ---------------------------------------------------------------------------

model IngestionLog {
  id             String              @id @default(uuid())
  evidenceItemId String?             @map("evidence_item_id")
  sourceName     String              @map("source_name")
  sourceType     EvidenceSourceType? @map("source_type")
  outcome        IngestionOutcome
  extractedChars Int?                @map("extracted_chars")
  chunkCount     Int?                @map("chunk_count")
  /// Short machine reason, never extracted document text.
  failureReason  String?             @map("failure_reason")
  createdAt      DateTime            @default(now()) @map("created_at")

  evidenceItem EvidenceItem? @relation(fields: [evidenceItemId], references: [id], onDelete: SetNull)

  @@index([evidenceItemId])
  @@index([createdAt])
  @@map("ingestion_log")
}
