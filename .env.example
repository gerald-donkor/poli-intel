# EviBrief environment variables — canonical list (AGENTS.md §18).
# Keys only, no values. Copy to .env.local and fill in. Never commit a secret.
# Only NEXT_PUBLIC_* values may reach browser code; everything else is server-only.

# Gemini 3.6 Flash generation, Gemini Embedding 2, Google Search grounding — server only
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase pooled connection for Prisma Client — server only
DATABASE_URL=
# Supabase direct connection for Prisma migrations — server only
DIRECT_URL=

# Supabase project URL — client + server
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key — client + server
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role access for server-side jobs and storage — server only
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js v5 session and JWT signing — server only
AUTH_SECRET=
# Auth.js canonical deployment URL — server only
AUTH_URL=
# Google Workspace OAuth client ID — server only
AUTH_GOOGLE_ID=
# Google Workspace OAuth client secret — server only
AUTH_GOOGLE_SECRET=
# Workspace domain restriction for SSO sign-in — server only
AUTH_ALLOWED_DOMAIN=

# Sending events to Inngest — server only
INNGEST_EVENT_KEY=
# Verifying Inngest requests to the serve endpoint — server only
INNGEST_SIGNING_KEY=

# Morning digest and notification email — server only
RESEND_API_KEY=
# Verified sender address for digests — server only
DIGEST_FROM_EMAIL=

# PDF and document ingestion uploads — server only
UPLOADTHING_TOKEN=

# Optional; signal digest delivery to Slack — server only
SLACK_WEBHOOK_URL=

# WhatsApp Business API auth (Twilio or 360dialog) — server only
WHATSAPP_API_TOKEN=
# WhatsApp sender identity — server only
WHATSAPP_PHONE_NUMBER_ID=

# Africa's Talking USSD gateway auth — server only
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Server-side error reporting — server only
SENTRY_DSN=
# Source map upload at build time — server only
SENTRY_AUTH_TOKEN=
# Browser error reporting — client + server
NEXT_PUBLIC_SENTRY_DSN=

# PostHog project key — client + server
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (self-hosted) — client + server
NEXT_PUBLIC_POSTHOG_HOST=
