# EviBrief environment variables — canonical list (AGENTS.md §18).
# Keys only, no values. Copy to .env.local and fill in. Never commit a secret.
# Only NEXT_PUBLIC_* values may reach browser code; everything else is server-only.

# Gemini 3.6 Flash generation, Gemini Embedding 2, Google Search grounding — server only
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase pooled connection for Prisma Client — server only
DATABASE_URL=
# Supabase direct connection for Prisma migrations — server only
DIRECT_URL=

# Supabase project URL — client + server
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key — client + server
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role access for server-side jobs and storage — server only
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js v5 session and JWT signing — server only
AUTH_SECRET=
# Auth.js canonical deployment URL — server only
AUTH_URL=
# Google Workspace OAuth client ID — server only
AUTH_GOOGLE_ID=
# Google Workspace OAuth client secret — server only
AUTH_GOOGLE_SECRET=
# Workspace domain restriction for SSO sign-in — server only
AUTH_ALLOWED_DOMAIN=

# Google Docs export. AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET above are REUSED for
# the Drive grant, and the Drive scope is deliberately NOT added to the sign-in
# request in auth.ts: a Field Officer who can never export must never be asked
# for Drive access. The grant is requested separately, the first time someone
# exports a brief to Google Docs, and is scoped to drive.file — files this
# application created, nothing else.
#
# This key seals the stored refresh token at rest (AES-256-GCM). 32 bytes,
# base64: openssl rand -base64 32. Unset means no Google Docs export on this
# deployment — Word export is unaffected — server only
DRIVE_TOKEN_ENCRYPTION_KEY=

# PDF export. Pandoc is an external binary this application shells out to, so
# PDF is offered only where the deployment declares one. Absolute path to the
# executable; UNSET MEANS PDF EXPORT IS NOT OFFERED, which is the correct state
# on a host without it (Vercel does not ship Pandoc) — Word and Google Docs are
# unaffected — server only
PANDOC_BIN=
# The engine Pandoc renders the PDF through. Defaults to weasyprint when unset,
# which is a pip install; Pandoc's own default, pdflatex, needs a full TeX
# installation — server only
PANDOC_PDF_ENGINE=

# Sending events to Inngest — server only
INNGEST_EVENT_KEY=
# Verifying Inngest requests to the serve endpoint — server only
INNGEST_SIGNING_KEY=

# Morning digest and notification email — server only
RESEND_API_KEY=
# Verified sender address for digests — server only
DIGEST_FROM_EMAIL=

# PDF and document ingestion uploads — server only
UPLOADTHING_TOKEN=

# Optional; signal digest delivery to Slack — server only
SLACK_WEBHOOK_URL=

# WhatsApp Business API auth (Cloud API shape — Meta direct or 360dialog) — server only
WHATSAPP_API_TOKEN=
# WhatsApp sender identity — server only
WHATSAPP_PHONE_NUMBER_ID=
# App secret the inbound webhook's X-Hub-Signature-256 is checked against.
# A DIFFERENT VALUE from WHATSAPP_API_TOKEN above. The webhook has no login by
# design, so this signature IS its access control — server only
WHATSAPP_WEBHOOK_SECRET=
# Echoed back during the provider's one-time GET subscription handshake — server only
WHATSAPP_VERIFY_TOKEN=

# Africa's Talking account credentials, for a FUTURE OUTBOUND path (USSD push or
# SMS). Not read by the inbound USSD callback, which is request/response only
# — server only
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# High-entropy path segment the registered USSD callback URL carries
# (/api/ussd/<secret>). Africa's Talking does not sign its USSD callbacks, so
# this plus USSD_SERVICE_CODE below IS the access control for a path with no
# login by design. It appears in platform access logs, so rotate it — server only
AFRICASTALKING_USSD_SECRET=
# The registered short code, e.g. "*384*1234#". The posted serviceCode must
# match it, so a leaked callback URL alone is not a key — server only.
# QUOTE IT. dotenv treats an unquoted `#` as the start of a comment, so
# *384*1234# loads as *384*1234 and every callback 403s with nothing to explain
# why. The quotes are part of the value's syntax here, not a style choice.
USSD_SERVICE_CODE=

# Server-side error reporting — server only
SENTRY_DSN=
# Source map upload at build time — server only
SENTRY_AUTH_TOKEN=
# Browser error reporting — client + server
NEXT_PUBLIC_SENTRY_DSN=

# PostHog project key — client + server. Inert unless host is also set.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (self-hosted) — required; there is no PostHog Cloud fallback.
NEXT_PUBLIC_POSTHOG_HOST=

# Operator acknowledgement for production deployment readiness. Set exactly to
# `non_hobby` only after confirming the Tropenbos production deployment will use
# Vercel Pro, Enterprise, or an explicitly approved non-Hobby alternative. This
# is not a feature flag and does not bypass any runtime gate — server only
EVIBRIEF_VERCEL_PRODUCTION_PLAN_ACK=

# Seed data staff emails (Demo environment only).
# Used by npm run db:seed. Replace with real Google accounts if you want to
# sign in during a demo. If left blank, fake emails are generated.
SEED_DIRECTOR_EMAIL=
SEED_POLICY_OFFICER_EMAIL=
SEED_RESEARCH_OFFICER_EMAIL=
SEED_FIELD_OFFICER_EMAIL=
